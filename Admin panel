function U.Hover(btn, n, h, nt, ht)
    nt = nt or 0; ht = ht or 0
    btn.MouseEnter:Connect(function()
        U.Tween(btn, T.Fast, {BackgroundColor3 = h, BackgroundTransparency = ht})
    end)
    btn.MouseLeave:Connect(function()
        U.Tween(btn, T.Fast, {BackgroundColor3 = n, BackgroundTransparency = nt})
    end)
end

function U.Ripple(btn)
    btn.MouseButton1Click:Connect(function()
        local rip = Instance.new("Frame")
        rip.BackgroundColor3       = Color3.new(1,1,1)
        rip.BackgroundTransparency = 0.82
        rip.BorderSizePixel        = 0
        rip.Size                   = UDim2.new(0, 0, 0, 0)
        rip.Position               = UDim2.new(0.5, 0, 0.5, 0)
        rip.AnchorPoint            = Vector2.new(0.5, 0.5)
        rip.ZIndex                 = btn.ZIndex + 1
        rip.Parent                 = btn
        U.Corner(rip, UDim.new(1, 0))
        U.Tween(rip, TweenInfo.new(0.45, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
            {Size = UDim2.new(2.5, 0, 2.5, 0), BackgroundTransparency = 1})
        task.delay(0.5, function() rip:Destroy() end)
    end)
end

function U.FuzzyMatch(hay, needle)
    if needle == "" then return true, 100 end
    hay = hay:lower(); needle = needle:lower()
    if hay == needle then return true, 200 end
    if hay:sub(1, #needle) == needle then return true, 150 end
    if hay:find(needle, 1, true) then return true, 100 end
    local hi = 1
    for i = 1, #needle do
        local f = hay:find(needle:sub(i,i), hi, true)
        if not f then return false, 0 end
        hi = f + 1
    end
    return true, 60
end

function U.HighlightMatch(text, query)
    if query == "" then return text end
    local lo = text:lower()
    local ql = query:lower()
    local s, e = lo:find(ql, 1, true)
    if s then
        return text:sub(1, s-1)
            .. '<font color="rgb(165,110,255)"><b>'
            .. text:sub(s, e)
            .. "</b></font>"
            .. text:sub(e+1)
    end
    return text
end

function U.ParseArgs(raw)
    local args = {}
    for token in raw:gmatch("%S+") do
        table.insert(args, token)
    end
    return args
end

