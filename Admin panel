function U.Hover(btn, n, h, nt, ht)
    nt = nt or 0; ht = ht or 0
    btn.MouseEnter:Connect(function()
        U.Tween(btn, T.Fast, {BackgroundColor3=h, BackgroundTransparency=ht})
    end)
    btn.MouseLeave:Connect(function()
        U.Tween(btn, T.Fast, {BackgroundColor3=n, BackgroundTransparency=nt})
    end)
end

function U.Ripple(btn)
    btn.MouseButton1Click:Connect(function()
        local r = Instance.new("Frame")
        r.BackgroundColor3       = Color3.new(1,1,1)
        r.BackgroundTransparency = 0.84
        r.BorderSizePixel        = 0
        r.Size                   = UDim2.new(0,0,0,0)
        r.Position               = UDim2.new(0.5,0,0.5,0)
        r.AnchorPoint            = Vector2.new(0.5,0.5)
        r.ZIndex                 = btn.ZIndex + 1
        r.Parent                 = btn
        U.Corner(r, UDim.new(1,0))
        U.Tween(r, TweenInfo.new(0.42, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
            {Size=UDim2.new(2.5,0,2.5,0), BackgroundTransparency=1})
        task.delay(0.5, function() r:Destroy() end)
    end)
end

function U.FuzzyMatch(hay, needle)
    if needle == "" then return true, 100 end
    hay = hay:lower(); needle = needle:lower()
    if hay == needle then return true, 200 end
    if hay:sub(1,#needle) == needle then return true, 150 end
    if hay:find(needle, 1, true) then return true, 100 end
    local hi = 1
    for i = 1, #needle do
        local f = hay:find(needle:sub(i,i), hi, true)
        if not f then return false, 0 end
        hi = f + 1
    end
    return true, 60
end

function U.HighlightMatch(text, query)
    if query == "" then return text end
    local lo = text:lower(); local ql = query:lower()
    local s, e = lo:find(ql, 1, true)
    if s then
        return text:sub(1,s-1)..'<font color="rgb(172,120,255)"><b>'..text:sub(s,e).."</b></font>"..text:sub(e+1)
    end
    return text
end

function U.ParseArgs(raw)
    local a = {}
    for t in raw:gmatch("%S+") do table.insert(a,t) end
    return a
end

function U.FindPlayer(name)
    if not name then return nil end
    local nl = name:lower()
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Name:lower():sub(1,#nl) == nl then return p end
    end
    return nil
end

function U.GetChar(p)
    return (p or LP).Character
end

function U.GetHum(p)
    local c = U.GetChar(p)
    return c and c:FindFirstChildOfClass("Humanoid")
end

function U.GetRoot(p)
    local c = U.GetChar(p)
    return c and c:FindFirstChild("HumanoidRootPart")
end

