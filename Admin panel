local NavItems = {}
local ActiveNavItem = nil

local function makeNavItem(parent, icon, label, pageKey, badge, badgeColor)
    local btn = makeButton(parent, "", UDim2.new(1, 0, 0, 34), nil, Color3.new(0,0,0), C.TextDim, 12)
    btn.BackgroundTransparency = 1
    btn.ZIndex = 12
    corner(btn, 4)

    local iconL = makeLabel(btn, icon, 14, C.TextDim, Enum.TextXAlignment.Center, Enum.Font.GothamBold)
    iconL.Size = UDim2.new(0, 22, 1, 0)
    iconL.Position = UDim2.new(0, 8, 0, 0)
    iconL.ZIndex = 12

    local nameL = makeLabel(btn, label, 12, C.TextDim, Enum.TextXAlignment.Left, Enum.Font.Gotham)
    nameL.Size = UDim2.new(1, -52, 1, 0)
    nameL.Position = UDim2.new(0, 34, 0, 0)
    nameL.ZIndex = 12

    local accent = makeFrame(btn, UDim2.new(0, 3, 0, 20), UDim2.new(0, 0, 0.5, -10), C.Cyan)
    accent.Visible = false
    corner(accent, 2)

    if badge then
        local badgeL = makeBadge(btn, tostring(badge), badgeColor or C.Violet)
        badgeL.Position = UDim2.new(1, -32, 0.5, -9)
        badgeL.ZIndex = 13
    end

    local function activate()
        if ActiveNavItem then
            ActiveNavItem.accent.Visible = false
            tween(ActiveNavItem.btn, {BackgroundTransparency = 1}, 0.15)
            tween(ActiveNavItem.iconL, {TextColor3 = C.TextDim}, 0.15)
            tween(ActiveNavItem.nameL, {TextColor3 = C.TextDim}, 0.15)
        end
        accent.Visible = true
        tween(btn, {BackgroundColor3 = Color3.fromRGB(14, 28, 56), BackgroundTransparency = 0}, 0.15)
        tween(iconL, {TextColor3 = C.Cyan}, 0.15)
        tween(nameL, {TextColor3 = C.Cyan}, 0.15)
        ActiveNavItem = {btn=btn, iconL=iconL, nameL=nameL, accent=accent}
    end

    btn.MouseEnter:Connect(function()
        if ActiveNavItem and ActiveNavItem.btn ~= btn then
            tween(btn, {BackgroundTransparency = 0.85, BackgroundColor3 = Color3.fromRGB(10,20,40)}, 0.1)
        end
    end)
    btn.MouseLeave:Connect(function()
        if ActiveNavItem and ActiveNavItem.btn ~= btn then
            tween(btn, {BackgroundTransparency = 1}, 0.1)
        end
    end)

    btn.MouseButton1Click:Connect(function()
        activate()
        if Pages[pageKey] then
            for _, p in pairs(Pages) do p.Visible = false end
            Pages[pageKey].Visible = true
            PageTitleLabel.Text = label
        end
    end)

    NavItems[pageKey] = {btn=btn, iconL=iconL, nameL=nameL, accent=accent, activate=activate}
    return btn
end

