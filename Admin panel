		description = "Teleports you to target player.",
		usage = "teleport <player>",
		minRank = RANKS.MOD,
		run = function(player, args)
			local targetName = args[1]
			if not targetName then
				return { success = false, message = "Usage: teleport <player>" }
			end
			local target = Players:FindFirstChild(targetName)
			local callerChar = player.Character
			if not target or not target.Character or not callerChar then
				return { success = false, message = "Invalid target or missing character." }
			end
			local targetRoot = target.Character:FindFirstChild("HumanoidRootPart")
			local callerRoot = callerChar:FindFirstChild("HumanoidRootPart")
			if not targetRoot or not callerRoot then
				return { success = false, message = "Missing HumanoidRootPart." }
			end
			callerRoot.CFrame = targetRoot.CFrame + Vector3.new(0, 2, 0)
			return { success = true, message = "Teleported to " .. target.Name }
		end,
	})

	CommandRegistry.register({
		name = "listcommands",
		aliases = { "help", "cmds" },
		category = "Diagnostics",
		description = "Lists all available commands.",
		usage = "listcommands",
		minRank = RANKS.DEFAULT,
		run = function(player, args)
			local names = {}
			for _, def in ipairs(CommandRegistry.list()) do
				table.insert(names, def.name)
			end
			return { success = true, message = "Commands: " .. table.concat(names, ", ") }
		end,
	})

	-- Remote wiring -----------------------------------------------------
	ExecuteCommand.OnServerEvent:Connect(function(player, commandName, args)
		if type(commandName) ~= "string" then return end
		if args ~= nil and type(args) ~= "table" then return end

		local permitted, reason = PermissionSystem.hasPermission(player, commandName)
		if not permitted then
			CommandResponse:FireClient(player, {
				success = false,
				message = "[DENIED] " .. reason,
				commandName = commandName,
				timestamp = os.time(),
			})
			return
		end

		local result = CommandExecutor.execute(player, commandName, args)
		CommandResponse:FireClient(player, {
			success = result.success,
			message = result.message,
			commandName = commandName,
			timestamp = os.time(),
		})
	end)

	RequestPermission.OnServerInvoke = function(player, commandName)
		return PermissionSystem.hasPermission(player, commandName)
	end

	GetCommandList.OnServerInvoke = function(player)
		-- Only return commands the player can see (their rank meets minimum,
		-- or show all with a locked flag — foundation returns all with lock state)
		local rank = PermissionSystem.getRank(player)
		local out = {}
		for _, def in ipairs(CommandRegistry.list()) do
			table.insert(out, {
				name = def.name,
				category = def.category,
				description = def.description,
				usage = def.usage,
				aliases = def.aliases,
				locked = rank < def.minRank,
			})
		end
		return out
	end

