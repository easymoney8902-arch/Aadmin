            local il = makeLabel(row, pi.icon, 14, C.Cyan, Enum.TextXAlignment.Center, Enum.Font.GothamBold)
            il.Size = UDim2.new(0, 28, 1, 0); il.ZIndex = 104

            local nl = makeLabel(row, pi.label, 13, C.Text, Enum.TextXAlignment.Left, Enum.Font.Gotham)
            nl.Size = UDim2.new(1, -40, 1, 0); nl.Position = UDim2.new(0, 34, 0, 0); nl.ZIndex = 104

            row.MouseEnter:Connect(function() tween(row, {BackgroundTransparency = 0.8}, 0.1) end)
            row.MouseLeave:Connect(function() tween(row, {BackgroundTransparency = 1}, 0.1) end)

            local pPage = pi.page
            local pAction = pi.action
            row.MouseButton1Click:Connect(function()
                closePalette()
                if pPage and NavItems[pPage] then
                    NavItems[pPage].btn.MouseButton1Click:Fire()
                elseif pAction == "report" then
                    toast("Report generated", "success", "📄 Report Ready")
                elseif pAction == "sidebar" then
                    -- sidebar toggle handled below
                end
            end)
        end
    end

    -- Command matches
    if q:len() > 0 then
        local cmdCount = 0
        for _, cmd in ipairs(ALL_COMMANDS) do
            if (cmd.cmd..cmd.desc):lower():find(ql,1,true) then
                cmdCount = cmdCount + 1
                if cmdCount > 5 then break end
                shown = shown + 1
                local row = makeButton(CPResults, "", UDim2.new(1, 0, 0, 34), nil, Color3.new(0,0,0), C.Text, 13)
                row.BackgroundTransparency = 1
                row.ZIndex = 103
                corner(row, 6)
                row.LayoutOrder = shown + 100

                local il = makeLabel(row, "⌘", 13, C.Violet, Enum.TextXAlignment.Center, Enum.Font.GothamBold)
                il.Size = UDim2.new(0, 28, 1, 0); il.ZIndex = 104

                local nl = makeLabel(row, ":"..cmd.cmd.."  —  "..cmd.desc, 12, C.TextDim, Enum.TextXAlignment.Left, Enum.Font.Gotham)
                nl.Size = UDim2.new(1, -40, 1, 0); nl.Position = UDim2.new(0, 34, 0, 0); nl.ZIndex = 104

                row.MouseEnter:Connect(function() tween(row, {BackgroundTransparency = 0.8}, 0.1) end)
                row.MouseLeave:Connect(function() tween(row, {BackgroundTransparency = 1}, 0.1) end)

                local cmdStr = cmd.cmd
                row.MouseButton1Click:Connect(function()
                    closePalette()
                    if NavItems["terminal"] then NavItems["terminal"].btn.MouseButton1Click:Fire() end
                    task.wait(0.15)
                    if _G.NX_TermInput then _G.NX_TermInput.Text = cmdStr end
                    toast(":"..cmdStr.." loaded in terminal", "info")
                end)
            end
        end
    end
end

