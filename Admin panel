local function corner(obj, r)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, r or 6)
    c.Parent = obj
end

local function pad(obj, t, b, l, r)
    local p = Instance.new("UIPadding")
    p.PaddingTop    = UDim.new(0, t or 0)
    p.PaddingBottom = UDim.new(0, b or 0)
    p.PaddingLeft   = UDim.new(0, l or 0)
    p.PaddingRight  = UDim.new(0, r or 0)
    p.Parent = obj
end

local function listLayout(obj, dir, halign, spacing)
    local l = Instance.new("UIListLayout")
    l.FillDirection       = dir or Enum.FillDirection.Vertical
    l.HorizontalAlignment = halign or Enum.HorizontalAlignment.Left
    l.Padding             = UDim.new(0, spacing or 0)
    l.SortOrder           = Enum.SortOrder.LayoutOrder
    l.Parent = obj
    return l
end

local function gridLayout(obj, cellSize, cellPad)
    local g = Instance.new("UIGridLayout")
    g.CellSize    = cellSize or UDim2.new(0, 120, 0, 36)
    g.CellPadding = cellPad  or UDim2.new(0, 6, 0, 6)
    g.SortOrder   = Enum.SortOrder.LayoutOrder
    g.Parent = obj
    return g
end

local function tween(obj, props, t, style, dir)
    TweenService:Create(obj, TweenInfo.new(
        t or 0.18,
        style or Enum.EasingStyle.Quad,
        dir   or Enum.EasingDirection.Out
    ), props):Play()
end

