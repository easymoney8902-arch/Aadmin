-- :help — list all commands in notification + console
Registry:Add({
    aliases     = {"help", "h", "?"},
    description = "List all commands or get info on one",
    category    = "Info",
    args        = {{ name="command", type="string", optional=true, hint="speed" }},
    usage       = ":help [command]",
    execute     = function(args, raw, ctx)
        if args[1] then
            local def = Registry:Get(args[1])
            if not def then
                Notif.Push("No command: :"..args[1], "warn")
                return
            end
            Notif.Push(
                ":"..def.aliases[1].." — "..def.description.."\nUsage: "..(def.usage or ""),
                "info", 6
            )
        else
            local all  = Registry:All()
            local lines = {}
            table.sort(all, function(a,b) return a._canon < b._canon end)
            for _, d in ipairs(all) do
                table.insert(lines, ":"..d.aliases[1].." — "..(d.description or ""))
            end
            -- Print to executor console
            for _, l in ipairs(lines) do print(l) end
            Notif.Push(#all.." commands available. See executor console for full list.", "info", 4)
            -- Also open panel and show all
            SetVisible(true)
            activeTab = "All"
            SearchBox.Text = ""
            BuildCommandList("")
            BuildTabs()
        end
    end,
})

