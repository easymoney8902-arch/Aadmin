	-- Command cache (populated from server) ----------------------------
	local commandCache = {}

	local function refreshCommandCache()
		local ok, list = pcall(function()
			return GetCommandList:InvokeServer()
		end)
		if ok and type(list) == "table" then
			commandCache = list
		end
	end

	local function clearAutocomplete()
		for _, child in ipairs(autocompleteFrame:GetChildren()) do
			if child:IsA("TextButton") then
				child:Destroy()
			end
		end
		autocompleteFrame.Visible = false
	end

	local function buildAutocomplete(query)
		clearAutocomplete()
		if query == "" then return end

		local matches = {}
		for _, def in ipairs(commandCache) do
			if string.sub(def.name, 1, #query) == query and not def.locked then
				table.insert(matches, def)
			end
		end
		table.sort(matches, function(a, b) return a.name < b.name end)

		if #matches == 0 then return end

		for i, def in ipairs(matches) do
			if i > 8 then break end
			local optBtn = Instance.new("TextButton")
			optBtn.Name = "Opt" .. i
			optBtn.Size = UDim2.new(1, 0, 0, 28)
			optBtn.BackgroundColor3 = Color3.fromRGB(16, 16, 22)
			optBtn.BackgroundTransparency = 0.3
			optBtn.Text = string.format("%s  —  %s", def.name, def.description)
			optBtn.TextXAlignment = Enum.TextXAlignment.Left
			optBtn.Font = THEME.font
			optBtn.TextSize = 12
			optBtn.TextColor3 = THEME.textPrimary
			optBtn.TextTruncate = Enum.TextTruncate.AtEnd
			optBtn.LayoutOrder = i
			optBtn.Parent = autocompleteFrame

			local optPad = Instance.new("UIPadding")
			optPad.PaddingLeft = UDim.new(0, 10)
			optPad.Parent = optBtn

			optBtn.MouseButton1Click:Connect(function()
				inputBox.Text = def.name .. " "
				clearAutocomplete()
				inputBox:CaptureFocus()
			end)
		end

		autocompleteFrame.Visible = true
	end

	inputBox:GetPropertyChangedSignal("Text"):Connect(function()
		local text = inputBox.Text
		local firstWord = text:match("^(%S*)") or ""
		if text == "" or text:find(" ") then
			clearAutocomplete()
		else
			buildAutocomplete(firstWord)
		end
	end)

	-- Submit logic -------------------------------------------------------
	local function submitCommand()
		local raw = inputBox.Text
		if raw == "" then return end

		local parts = {}
		for word in raw:gmatch("%S+") do
			table.insert(parts, word)
		end
		local commandName = table.remove(parts, 1)

		pushHistoryEntry("> " .. raw, "info")
		clearAutocomplete()
		inputBox.Text = ""

		ExecuteCommand:FireServer(commandName, parts)
	end

	executeButton.MouseButton1Click:Connect(submitCommand)
	inputBox.FocusLost:Connect(function(enterPressed)
		if enterPressed then
			submitCommand()
		end
	end)

	CommandResponse.OnClientEvent:Connect(function(payload)
		local prefix = payload.success and "[OK]" or "[FAIL]"
		pushHistoryEntry(prefix .. " " .. payload.message, payload.success and "success" or "error")
	end)

	-- Toggle keybind (RightControl) ---------------------------------------
	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed then return end
		if input.KeyCode == Enum.KeyCode.RightControl then
			mainFrame.Visible = not mainFrame.Visible
			if mainFrame.Visible then
				refreshCommandCache()
				mainFrame.BackgroundTransparency = 1
				tween(mainFrame, { BackgroundTransparency = THEME.panelBgAlpha }, 0.18)
			end
		end
	end)

	refreshCommandCache()

	print("[AdminSystem] Client UI initialized. Press RightControl to toggle.")
end
