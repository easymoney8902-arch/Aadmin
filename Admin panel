-- CHAT HOOK  ( :command args )
-- ══════════════════════════════════════════════════════════════
local function OnChat(msg)
    if msg:sub(1,1) ~= ":" then return end
    ExecCommand(msg)
    -- suppress the chat message visually (best-effort in executor)
    pcall(function()
        StarterGui:SetCore("ChatMakeSystemMessage", {
            Text      = "[Apex] Ran: " .. msg,
            Color     = T.Violet,
            Font      = Enum.Font.GothamBold,
            TextSize  = 14,
        })
    end)
end

local chatConn
pcall(function()
    local ChatService = game:GetService("Chat")
    -- executor hook
    chatConn = LP.Chatted:Connect(OnChat)
end)
ENV.ApexAdmin_ChatConn = chatConn

