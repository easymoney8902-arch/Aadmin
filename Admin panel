Registry:Add({aliases={"freecam","fc"},description="Toggle free camera",category="Camera",
    args={{name="speed",type="number",optional=true,hint="30"}},usage=":freecam [speed]",
    execute=function(args)
        State.freecam=not State.freecam
        local spd=tonumber(args[1]) or 30
        if State.freecam then
            Cam.CameraType=Enum.CameraType.Scriptable
            local cf=Cam.CFrame
            local conn; conn=RunService.RenderStepped:Connect(function(dt)
                if not State.freecam then
                    Cam.CameraType=Enum.CameraType.Custom; conn:Disconnect(); return
                end
                local mv=Vector3.zero
                if UserInputService:IsKeyDown(Enum.KeyCode.W) then mv=mv+cf.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.S) then mv=mv-cf.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.A) then mv=mv-cf.RightVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.D) then mv=mv+cf.RightVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.E) then mv=mv+Vector3.new(0,1,0) end
                if UserInputService:IsKeyDown(Enum.KeyCode.Q) then mv=mv-Vector3.new(0,1,0) end
                cf=cf+mv*(spd*dt); Cam.CFrame=cf
            end)
            Notif.Push("FreeCam ON (WASD+QE)","success")
        else
            Cam.CameraType=Enum.CameraType.Custom; Notif.Push("FreeCam OFF","warn")
        end
    end,
})

