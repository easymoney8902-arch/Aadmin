local function HideDropdown()
    U.Tween(DropFrame, T.Fast, {Size=UDim2.new(1,0,0,0)})
    selectedDropIdx=1
end

local function ShowDropdown(defs)
    for _, ch in ipairs(DropScroll:GetChildren()) do
        if not ch:IsA("UIListLayout") and not ch:IsA("UIPadding") then ch:Destroy() end
    end
    dropItems = defs
    if #defs==0 then HideDropdown(); return end
    local rowH  = 34
    for i, def in ipairs(defs) do
        local cd = Registry.CategoryDefs[def.category] or {}
        local sel = i==selectedDropIdx
        local row = U.Button({bg=sel and T.GlassSel or T.GlassSurf,
            tr=sel and 0 or T.SurfTr, size=UDim2.new(1,0,0,rowH), text="", z=22})
        row.LayoutOrder=i; U.Corner(row, T.R)

        local ns = ":"..def.aliases[1]
        if def.args and #def.args>0 then
            local hints={}
            for _, a in ipairs(def.args) do
                table.insert(hints, a.optional and "["..a.name.."]" or "<"..a.name..">")
            end
            ns = ns.." "..table.concat(hints," ")
        end

        U.Label({text=cd.icon or "◆", col=cd.col or T.Violet, font=T.FontBold, sz=12,
            size=UDim2.new(0,24,1,0), pos=UDim2.new(0,4,0,0),
            xa=Enum.TextXAlignment.Center, z=23, parent=row})
        U.Label({text=ns, col=T.TxtPri, font=T.FontMono, sz=T.SzBody,
            size=UDim2.new(0.58,-28,1,0), pos=UDim2.new(0,28,0,0), z=23, parent=row})
        U.Label({text=def.description or "", col=T.TxtSec, font=T.FontLight, sz=T.SzSmall,
            size=UDim2.new(0.42,0,1,0), pos=UDim2.new(0.58,0,0,0), z=23, parent=row})

        row.MouseButton1Click:Connect(function()
            SearchBox.Text = ":"..def.aliases[1].." "
            SearchBox.CursorPosition = #SearchBox.Text+1
            HideDropdown()
        end)
        row.Parent = DropScroll
    end
    DropScroll.CanvasSize = UDim2.new(0,0,0, rowH*#defs+8)
    local vis = math.min(#defs*rowH+8, T.DropMaxH)
    U.Tween(DropFrame, T.Med, {Size=UDim2.new(1,0,0,vis)})
end

local function UpdateDropSel(idx)
    selectedDropIdx = math.max(1, math.min(#dropItems, idx))
    for i, ch in ipairs(DropScroll:GetChildren()) do
        if ch:IsA("TextButton") then
            local s = i==selectedDropIdx
            U.Tween(ch, T.Fast, {
                BackgroundColor3       = s and T.GlassSel or T.GlassSurf,
                BackgroundTransparency = s and 0         or T.SurfTr,
            })
        end
    end
end

-- ══════════════════════════════════════════════════════════════
-- EXECUTOR
-- ══════════════════════════════════════════════════════════════
local function ExecCommand(rawInput)
    rawInput = rawInput:match("^%s*(.-)%s*$")
    if rawInput=="" then return end
    History:Push(rawInput)
    History:ResetCursor()

    local stripped = rawInput:match("^:(.+)") or rawInput
    local tokens   = U.ParseArgs(stripped)
    if #tokens==0 then return end

    local key  = tokens[1]:lower()
    local args = {table.unpack(tokens,2)}
    local def  = Registry:Get(key)

    if not def then
        Notif.Push("Unknown: :"..key, "error", 2.5)
        StatusLabel.Text = "Unknown: :"..key
        return
    end

    StatusLabel.Text = "Ran: :"..def.aliases[1]

    local ok, err = pcall(def.execute, args, rawInput, {
        player=LP, notif=Notif, registry=Registry, loops=ENV.ApexLoops,
    })
    if not ok then
        Notif.Push("Error: "..tostring(err), "error", 4)
        StatusLabel.Text = "Error in :"..def.aliases[1]
    end
end

-- ── Input wiring
local function HandleInput(text)
    local s = text:match("^:?(.*)") or ""
    if text:sub(1,1)==":" and #s>0 then
        ShowDropdown(Registry:Search(s, 8))
    else
        HideDropdown()
    end
    BuildCommandList(text)
end

SearchBox:GetPropertyChangedSignal("Text"):Connect(function()
    HandleInput(SearchBox.Text)
end)

SearchBox.FocusLost:Connect(function(enter)
    if enter then
        local text = SearchBox.Text:match("^%s*(.-)%s*$")
        if text:sub(1,1)==":" then
            if #dropItems>0 and DropFrame.Size.Y.Offset>0 then
                ExecCommand(":"..dropItems[selectedDropIdx].aliases[1])
            else
                ExecCommand(text)
            end
        end
        SearchBox.Text=""; HideDropdown(); BuildCommandList("")
    else
        HideDropdown()
    end
end)

SearchBox.Focused:Connect(function()
    U.Tween(SearchAccent, T.Med, {Size=UDim2.new(1,0,0,2)})
end)

UserInputService.InputBegan:Connect(function(inp, gpe)
    if gpe then return end
    if inp.KeyCode==Enum.KeyCode.F2 then
        if PanelRoot.Visible or MinBar.Visible then SetVisible(not GuiVisible)
        else PanelRoot.Visible=true; SetVisible(true) end
    end
    if not SearchBox:IsFocused() and not MinInput:IsFocused() then return end
    if inp.KeyCode==Enum.KeyCode.Up then
        if #dropItems>0 and DropFrame.Size.Y.Offset>0 then UpdateDropSel(selectedDropIdx-1)
        else local p=History:Prev(); SearchBox.Text=p; MinInput.Text=p end
    elseif inp.KeyCode==Enum.KeyCode.Down then
        if #dropItems>0 and DropFrame.Size.Y.Offset>0 then UpdateDropSel(selectedDropIdx+1)
        else local n=History:Next(); SearchBox.Text=n; MinInput.Text=n end
    elseif inp.KeyCode==Enum.KeyCode.Escape then
        HideDropdown(); SearchBox:ReleaseFocus(); MinInput:ReleaseFocus()
    elseif inp.KeyCode==Enum.KeyCode.Tab then
        if #dropItems>0 then
            SearchBox.Text=":"..dropItems[selectedDropIdx].aliases[1].." "
            SearchBox.CursorPosition=#SearchBox.Text+1
            HideDropdown()
        end
    end
end)

MinInput.FocusLost:Connect(function(enter)
    if enter then
        local t=MinInput.Text:match("^%s*(.-)%s*$")
        if t~="" then ExecCommand(t:sub(1,1)==":" and t or ":"..t) end
        MinInput.Text=""
    end
end)

