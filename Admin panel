-- ============================================================
UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe and not State.CmdPaletteOpen then return end

    -- Ctrl/Cmd+K → Command Palette
    if (UserInputService:IsKeyDown(Enum.KeyCode.LeftControl)
    or  UserInputService:IsKeyDown(Enum.KeyCode.RightControl))
    and input.KeyCode == Enum.KeyCode.K then
        if State.CmdPaletteOpen then closePalette() else openPalette() end
        return
    end

    -- Escape
    if input.KeyCode == Enum.KeyCode.Escape then
        if State.CmdPaletteOpen then closePalette() end
        return
    end

    -- Ctrl+B → Toggle minimise
    if (UserInputService:IsKeyDown(Enum.KeyCode.LeftControl)
    or  UserInputService:IsKeyDown(Enum.KeyCode.RightControl))
    and input.KeyCode == Enum.KeyCode.B then
        MinBtn.MouseButton1Click:Fire()
        return
    end
end)

