            size=UDim2.new(0,28,1,0),pos=UDim2.new(0,7,0,0),
            xa=Enum.TextXAlignment.Center,z=14,parent=row})

        -- name (highlighted)
        U.Label({text=U.HighlightMatch(":"..def.aliases[1],":"..clean),
            col=T.TxtPri,font=T.FontBold,sz=T.SzBody,
            size=UDim2.new(0.44,-34,0,20),pos=UDim2.new(0,36,0,3),
