local activeTab="All"

local function BuildCommandList(query)
    query=query or SearchBox.Text
    local clean=query:match("^:?(.*)") or ""
    for _,ch in ipairs(CmdScroll:GetChildren()) do
        if ch:IsA("Frame") or ch:IsA("TextButton") then ch:Destroy() end
    end
    local results=Registry:Search(clean,100)
    if activeTab~="All" then
        local f={}
        for _,d in ipairs(results) do
            if d.category==activeTab then table.insert(f,d) end
        end
        results=f
    end
    if #results==0 then
        U.Label({text="No commands found.",col=T.TxtDim,font=T.FontLight,sz=T.SzBody,
            size=UDim2.new(1,0,0,38),xa=Enum.TextXAlignment.Center,z=13,parent=CmdScroll})
        CmdScroll.CanvasSize=UDim2.new(0,0,0,38)
        return
    end
    local totalH=0
    for i,def in ipairs(results) do
        local cd=Registry.CategoryDefs[def.category] or {}
        local ac=cd.col or T.Violet
        local ic=cd.icon or "+"

        local row=U.Frame({name="Row_"..i,bg=T.GlassSurf,tr=T.RowTr,
            size=UDim2.new(1,-4,0,44),clip=false,z=13,parent=CmdScroll})
