            State.TermHistIdx = math.min(State.TermHistIdx + 1, #State.TermHistory - 1)
            if State.TermHistory[State.TermHistIdx + 1] then
                termInput.Text = State.TermHistory[State.TermHistIdx + 1]
                termInput.CursorPosition = #termInput.Text + 1
            end
        elseif input.KeyCode == Enum.KeyCode.Down then
            State.TermHistIdx = math.max(State.TermHistIdx - 1, -1)
            termInput.Text = State.TermHistIdx >= 0 and State.TermHistory[State.TermHistIdx + 1] or ""
        end
    end
end)

