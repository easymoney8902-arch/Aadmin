local activeTab  = "All"
local tabButtons = {}

local function BuildCommandList(query)
    query = query or SearchBox.Text
    local clean = query:match("^:?(.*)") or ""
    for _, ch in ipairs(CmdScroll:GetChildren()) do
        if ch:IsA("Frame") or ch:IsA("TextButton") then ch:Destroy() end
    end
    local results = Registry:Search(clean, 100)
    if activeTab ~= "All" then
        local f={}
        for _, d in ipairs(results) do
            if d.category==activeTab then table.insert(f,d) end
        end
        results=f
    end
    if #results==0 then
        U.Label({text="No commands found.", col=T.TxtDim, font=T.FontLight, sz=T.SzBody,
            size=UDim2.new(1,0,0,38), xa=Enum.TextXAlignment.Center, z=13, parent=CmdScroll})
        CmdScroll.CanvasSize = UDim2.new(0,0,0,38)
        return
    end
    local totalH = 0
    for i, def in ipairs(results) do
        local cd = Registry.CategoryDefs[def.category] or {}
        local ac = cd.col or T.Violet
        local ic = cd.icon or "◆"
        local row = U.Frame({name="Row_"..i, bg=T.GlassSurf, tr=T.RowTr,
            size=UDim2.new(1,-4,0,44), clip=false, z=13, parent=CmdScroll})
        row.LayoutOrder = i
        U.Corner(row, T.R)
        U.Stroke(row, T.Border, 1)

        local ab = Instance.new("Frame")
        ab.BackgroundColor3=ac; ab.BorderSizePixel=0
        ab.Size=UDim2.new(0,3,1,0); ab.ZIndex=14
        U.Corner(ab, UDim.new(0,3)); ab.Parent=row

        U.Label({text=ic, col=ac, font=T.FontBold, sz=13,
            size=UDim2.new(0,30,1,0), pos=UDim2.new(0,7,0,0),
            xa=Enum.TextXAlignment.Center, z=14, parent=row})

        U.Label({text=U.HighlightMatch(":"..def.aliases[1], ":"..clean),
            col=T.TxtPri, font=T.FontBold, sz=T.SzBody,
            size=UDim2.new(0.45,-36,0,20), pos=UDim2.new(0,38,0,3),
            rich=true, z=14, parent=row})

        if #def.aliases > 1 then
            local short = {}
            for ai = 2, math.min(#def.aliases, 5) do
                table.insert(short, ":"..def.aliases[ai])
            end
            U.Label({text=table.concat(short, "  "), col=T.TxtDim, font=T.FontLight, sz=T.SzSmall,
                size=UDim2.new(0.45,-36,0,14), pos=UDim2.new(0,38,0,24),
                z=14, parent=row})
        end

        U.Label({text=def.description or "", col=T.TxtSec, font=T.FontLight, sz=T.SzSmall,
            size=UDim2.new(0.5,-8,1,0), pos=UDim2.new(0.5,0,0,0), z=14, parent=row})

        local bw = math.max(40, #def.category * 7 + 10)
        local badge = U.Frame({bg=ac, tr=0.70,
            size=UDim2.new(0,bw,0,14), pos=UDim2.new(1,-(bw+8),0.5,-7), z=14, parent=row})
        U.Corner(badge, T.RPill)
        U.Label({text=def.category, col=T.TxtPri, font=T.FontBold, sz=T.SzTag,
            xa=Enum.TextXAlignment.Center, z=15, parent=badge})

        U.Hover(row, T.GlassSurf, T.GlassHov, T.RowTr, 0.04)

        local ca = U.Button({bg=Color3.new(0,0,0), tr=1, size=UDim2.new(1,0,1,0), z=15, parent=row})
        ca.MouseButton1Click:Connect(function()
            SearchBox.Text = ":"..def.aliases[1].." "
            SearchBox:CaptureFocus()
            SearchBox.CursorPosition = #SearchBox.Text+1
        end)
        totalH = totalH + 46
    end
    CmdScroll.CanvasSize = UDim2.new(0,0,0,totalH+8)
    CmdCountLabel.Text   = #results.." commands"
end

local function BuildTabs()
    for _, ch in ipairs(TabScroll:GetChildren()) do
        if ch:IsA("TextButton") then ch:Destroy() end
    end
    tabButtons = {}
    local list = {{ key="All", label="All", icon="★", col=T.Violet }}
    local sorted = {}
    for k, d in pairs(Registry.CategoryDefs) do
        if Registry._cats[k] and #Registry._cats[k]>0 then
            table.insert(sorted, {key=k, def=d})
        end
    end
    table.sort(sorted, function(a,b) return a.def.order < b.def.order end)
    for _, c in ipairs(sorted) do
        table.insert(list, {key=c.key, label=c.def.label, icon=c.def.icon, col=c.def.col})
    end
    for _, tab in ipairs(list) do
        local w   = math.max(52, #(tab.icon.." "..tab.label) * 7 + 14)
        local sel = tab.key == activeTab
        local btn = U.Button({bg=sel and T.Violet or T.GlassSurf,
            tr=sel and 0.60 or T.SurfTr,
            size=UDim2.new(0,w,0,22), text=tab.icon.." "..tab.label,
            col=sel and T.TxtPri or T.TxtSec,
            font=T.FontBold, sz=T.SzSmall, z=13})
        U.Corner(btn, T.RPill)
        U.Stroke(btn, T.Border, 1)
        U.Ripple(btn)
        btn.MouseButton1Click:Connect(function()
            activeTab = tab.key
            BuildTabs()
            BuildCommandList(SearchBox.Text)
        end)
        btn.LayoutOrder = tab.key=="All" and 0 or (tab.def and tab.def.order or 99)
        btn.Parent = TabScroll
        tabButtons[tab.key] = btn
    end
    local tot=0
    for _, ch in ipairs(TabScroll:GetChildren()) do
        if ch:IsA("TextButton") then tot=tot+ch.Size.X.Offset+3 end
    end
    TabScroll.CanvasSize = UDim2.new(0,tot+8,0,0)
end

