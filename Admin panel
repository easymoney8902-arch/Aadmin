-- CATEGORY TAB BUILDER
-- ══════════════════════════════════════════════════════════════
local activeTab    = "All"
local tabButtons   = {}

local function BuildTabs()
    for _, ch in ipairs(TabScroll:GetChildren()) do
        if ch:IsA("TextButton") then ch:Destroy() end
    end
    tabButtons = {}

    local tabList = {
        { key="All", label="All", icon="★", col=T.Violet }
    }
    local sortedCats = {}
    for catKey, catDef in pairs(Registry.CategoryDefs) do
        if Registry._cats[catKey] and #Registry._cats[catKey] > 0 then
            table.insert(sortedCats, { key=catKey, def=catDef })
        end
    end
    table.sort(sortedCats, function(a,b) return a.def.order < b.def.order end)
    for _, c in ipairs(sortedCats) do
        table.insert(tabList, { key=c.key, label=c.def.label, icon=c.def.icon, col=c.def.col })
    end

    for _, tab in ipairs(tabList) do
        local labelW = U.TextWidth(tab.icon.." "..tab.label, T.FontBold, T.SzSmall)
        local btnW   = math.max(56, labelW + 20)

        local btn = U.Button({
            bg   = tab.key == activeTab and T.Violet or T.Surface,
            tr   = tab.key == activeTab and 0.65    or T.SurfTrans,
            size = UDim2.new(0, btnW, 0, 24),
            text = tab.icon .. " " .. tab.label,
            col  = tab.key == activeTab and T.TxtPri or T.TxtSec,
            font = T.FontBold,
            sz   = T.SzSmall,
            z    = 13,
        })
        U.Corner(btn, T.RPill)
        U.Stroke(btn, T.Border, 1.5)
        U.Ripple(btn)

        btn.MouseButton1Click:Connect(function()
            activeTab = tab.key
            BuildTabs()
            -- rebuild command list for new tab
            BuildCommandList(SearchBox.Text)
        end)
        btn.LayoutOrder = tab.key == "All" and 0 or tab.def and tab.def.order or 99
        btn.Parent = TabScroll
        tabButtons[tab.key] = btn
    end

    -- recalc canvas
    local total = 0
    for _, ch in ipairs(TabScroll:GetChildren()) do
        if ch:IsA("TextButton") then total = total + ch.Size.X.Offset + 4 end
    end
    TabScroll.CanvasSize = UDim2.new(0, total + 12, 0, 0)
end

-- ══════════════════════════════════════════════════════════════
-- COMMAND LIST RENDERER
-- ══════════════════════════════════════════════════════════════
function BuildCommandList(query)
    query = query or SearchBox.Text
    -- strip leading colon for search
    local cleanQuery = query:match("^:?(.*)") or ""

    for _, ch in ipairs(CmdScroll:GetChildren()) do
        if ch:IsA("Frame") or ch:IsA("TextButton") then ch:Destroy() end
    end

    local results = Registry:Search(cleanQuery, 60)

    -- filter by tab
    if activeTab ~= "All" then
        local filtered = {}
        for _, def in ipairs(results) do
            if def.category == activeTab then
                table.insert(filtered, def)
            end
        end
        results = filtered
    end

    if #results == 0 then
        U.Label({
            text   = "No commands found.",
            col    = T.TxtDim,
            font   = T.FontLight,
            sz     = T.SzBody,
            size   = UDim2.new(1, 0, 0, 40),
            xa     = Enum.TextXAlignment.Center,
            z      = 13,
            parent = CmdScroll,
        })
        CmdScroll.CanvasSize = UDim2.new(0, 0, 0, 40)
        return
    end

    local totalH = 0
    for i, def in ipairs(results) do
        local catDef  = Registry.CategoryDefs[def.category] or {}
        local accentC = catDef.col or T.Violet
        local icon    = catDef.icon or "◆"

        local row = U.Frame({
            name   = "Row_"..i,
            bg     = T.Surface,
            tr     = T.SurfTrans,
            size   = UDim2.new(1, -4, 0, 48),
            z      = 13,
            clip   = false,
            parent = CmdScroll,
        })
        row.LayoutOrder = i
        U.Corner(row, T.R)
        U.Stroke(row, T.Border, 1.5)

        -- Left accent bar
        local accBar = Instance.new("Frame")
        accBar.BackgroundColor3 = accentC
        accBar.BorderSizePixel  = 0
        accBar.Size             = UDim2.new(0, 3, 1, 0)
        accBar.Position         = UDim2.new(0, 0, 0, 0)
        accBar.ZIndex           = 14
        U.Corner(accBar, UDim.new(0,3))
        accBar.Parent = row

        -- Category icon
        U.Label({
            text   = icon,
            col    = accentC,
            font   = T.FontBold,
            sz     = 14,
            size   = UDim2.new(0, 32, 1, 0),
            pos    = UDim2.new(0, 8, 0, 0),
            xa     = Enum.TextXAlignment.Center,
            z      = 14,
            parent = row,
        })

        -- Command name (highlighted)
        local displayName = ":"..def.aliases[1]
        local nameLbl = U.Label({
            text   = U.HighlightMatch(displayName, ":"..cleanQuery),
            col    = T.TxtPri,
            font   = T.FontBold,
            sz     = T.SzBody,
            size   = UDim2.new(0.5, -40, 0, 22),
            pos    = UDim2.new(0, 42, 0, 4),
            rich   = true,
            z      = 14,
            parent = row,
        })

        -- Aliases (small)
        if #def.aliases > 1 then
            local aliasStr = table.concat({table.unpack(def.aliases, 2, math.min(#def.aliases, 4))}, "  :")
            U.Label({
                text   = ":"..aliasStr,
                col    = T.TxtDim,
                font   = T.FontLight,
                sz     = T.SzSmall,
                size   = UDim2.new(0.4, 0, 0, 16),
                pos    = UDim2.new(0, 42, 0, 26),
                z      = 14,
                parent = row,
            })
        end

        -- Description
        U.Label({
            text   = def.description or "",
            col    = T.TxtSec,
            font   = T.FontLight,
            sz     = T.SzSmall,
            size   = UDim2.new(0.5, -10, 1, 0),
            pos    = UDim2.new(0.5, 0, 0, 0),
            z      = 14,
            parent = row,
        })

        -- Category badge
        local badgeW = U.TextWidth(def.category, T.FontBold, T.SzTag) + 14
        local badge  = U.Frame({
            bg   = accentC,
            tr   = 0.72,
            size = UDim2.new(0, badgeW, 0, 16),
            pos  = UDim2.new(1, -(badgeW+10), 0.5, -8),
            z    = 14,
            parent = row,
        })
        U.Corner(badge, T.RPill)
        U.Label({text=def.category, col=T.TxtPri, font=T.FontBold, sz=T.SzTag,
            size=UDim2.new(1,0,1,0), xa=Enum.TextXAlignment.Center, z=15, parent=badge})

        -- Hover
        U.Hover(row, T.Surface, T.SurfaceHov, T.SurfTrans, 0)

        -- Click to insert command in searchbox
        local clickArea = U.Button({
            bg   = Color3.new(0,0,0),
            tr   = 1,
            size = UDim2.new(1, 0, 1, 0),
            z    = 15,
            parent = row,
        })
        clickArea.MouseButton1Click:Connect(function()
            SearchBox.Text = ":"..def.aliases[1].." "
            SearchBox:CaptureFocus()
            SearchBox.CursorPosition = #SearchBox.Text + 1
        end)

        totalH = totalH + 50
    end

    CmdScroll.CanvasSize = UDim2.new(0, 0, 0, totalH + 8)
    CmdCountLabel.Text = #results .. " commands"
end

-- ══════════════════════════════════════════════════════════════
-- AUTOCOMPLETE DROPDOWN LOGIC
-- ══════════════════════════════════════════════════════════════
local function HideDropdown()
    U.Tween(DropFrame, T.Fast, {Size = UDim2.new(1, 0, 0, 0)})
    selectedDropIdx = 1
end

local function ShowDropdown(defs)
    for _, ch in ipairs(DropScroll:GetChildren()) do
        if not ch:IsA("UIListLayout") and not ch:IsA("UIPadding") then ch:Destroy() end
    end
    dropItems = defs

    if #defs == 0 then HideDropdown(); return end

    local rowH   = 36
    local maxVis = math.min(#defs, 7)
    local totalH = rowH * #defs + 8

    for i, def in ipairs(defs) do
        local catDef = Registry.CategoryDefs[def.category] or {}
        local row    = U.Button({
            bg   = i == selectedDropIdx and T.SurfaceSel or T.Surface,
            tr   = i == selectedDropIdx and 0           or T.SurfTrans,
            size = UDim2.new(1, 0, 0, rowH),
            text = "",
            z    = 22,
        })
        row.LayoutOrder = i
        U.Corner(row, T.R)

        local nameStr = ":"..def.aliases[1]
        if #def.args > 0 then
            local argHints = {}
            for _, a in ipairs(def.args) do
                table.insert(argHints, a.optional and "["..a.name.."]" or "<"..a.name..">")
            end
            nameStr = nameStr .. " " .. table.concat(argHints, " ")
        end

        U.Label({text=(catDef.icon or "◆"), col=catDef.col or T.Violet, font=T.FontBold, sz=13,
            size=UDim2.new(0,26,1,0), pos=UDim2.new(0,6,0,0), xa=Enum.TextXAlignment.Center, z=23, parent=row})
        U.Label({text=nameStr, col=T.TxtPri, font=T.FontMono, sz=T.SzBody,
            size=UDim2.new(0.6,-32,1,0), pos=UDim2.new(0,32,0,0), z=23, parent=row})
        U.Label({text=def.description or "", col=T.TxtSec, font=T.FontLight, sz=T.SzSmall,
            size=UDim2.new(0.4,0,1,0), pos=UDim2.new(0.6,0,0,0), z=23, parent=row})

        row.MouseButton1Click:Connect(function()
            SearchBox.Text = ":"..def.aliases[1].." "
            SearchBox.CursorPosition = #SearchBox.Text + 1
            HideDropdown()
        end)

        U.Hover(row,
            i == selectedDropIdx and T.SurfaceSel or T.Surface,
            T.SurfaceHov,
            i == selectedDropIdx and 0 or T.SurfTrans, 0)

        row.Parent = DropScroll
    end

    DropScroll.CanvasSize = UDim2.new(0, 0, 0, totalH)
    local visH = math.min(maxVis * rowH + 8, T.DropMaxH)
    U.Tween(DropFrame, T.Med, {Size = UDim2.new(1, 0, 0, visH)})
end

local function UpdateDropSelection(idx)
    selectedDropIdx = math.max(1, math.min(#dropItems, idx))
    for i, ch in ipairs(DropScroll:GetChildren()) do
        if ch:IsA("TextButton") then
            local isSel = i == selectedDropIdx
            U.Tween(ch, T.Fast, {
                BackgroundColor3       = isSel and T.SurfaceSel or T.Surface,
                BackgroundTransparency = isSel and 0            or T.SurfTrans,
            })
        end
    end
end

-- ══════════════════════════════════════════════════════════════
-- COMMAND EXECUTOR
-- ══════════════════════════════════════════════════════════════
local function ExecCommand(rawInput)
    rawInput = rawInput:match("^%s*(.-)%s*$")  -- trim
    if rawInput == "" then return end

    History:Push(rawInput)
    History:ResetCursor()

    local stripped = rawInput:match("^:(.+)") or rawInput
    local tokens   = U.ParseArgs(stripped)
    if #tokens == 0 then return end

    local cmdKey  = tokens[1]:lower()
    local cmdArgs = { table.unpack(tokens, 2) }

    local def = Registry:Get(cmdKey)
    if not def then
        Notif.Push("Unknown command: :"..cmdKey, "error", 3)
        StatusLabel.Text = "Unknown: :"..cmdKey
        return
    end

    StatusLabel.Text = "Ran: :"..def.aliases[1]

    local ok, err = pcall(def.execute, cmdArgs, rawInput, {
        player  = LP,
        notif   = Notif,
        registry = Registry,
    })

    if not ok then
        Notif.Push("Error: "..tostring(err), "error", 4)
        StatusLabel.Text = "Error in :"..def.aliases[1]
    end
end

-- ══════════════════════════════════════════════════════════════
-- SEARCH / INPUT WIRING
-- ══════════════════════════════════════════════════════════════
local function HandleInput(text)
    local stripped = text:match("^:?(.*)") or ""

    if text:sub(1,1) == ":" and #stripped > 0 then
        -- show autocomplete
        local matches = Registry:Search(stripped, 8)
        ShowDropdown(matches)
    else
        HideDropdown()
    end

    BuildCommandList(text)
end

SearchBox:GetPropertyChangedSignal("Text"):Connect(function()
    HandleInput(SearchBox.Text)
end)

SearchBox.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        local text = SearchBox.Text:match("^%s*(.-)%s*$")
        if text:sub(1,1) == ":" then
            -- if item selected in dropdown, use that
            if #dropItems > 0 and DropFrame.Size.Y.Offset > 0 then
                ExecCommand(":"..dropItems[selectedDropIdx].aliases[1])
            else
                ExecCommand(text)
            end
        end
        SearchBox.Text = ""
        HideDropdown()
        BuildCommandList("")
    else
        HideDropdown()
    end
end)

-- Focus line animation
SearchBox.Focused:Connect(function()
    U.Tween(SearchAccent, T.Med, {Size = UDim2.new(1, 0, 0, 2)})
    U.Tween(SearchBarHolder, T.Med, {})
end)

-- Keyboard navigation
UserInputService.InputBegan:Connect(function(inp, gpe)
    if gpe then return end

    -- Toggle panel: F2
    if inp.KeyCode == Enum.KeyCode.F2 then
        if PanelRoot.Visible or MinBar.Visible then
            SetVisible(not GuiVisible)
        else
            PanelRoot.Visible = true
            SetVisible(true)
        end
    end

    -- Focus search: /
    if inp.KeyCode == Enum.KeyCode.Slash and not GuiVisible then
        SetVisible(true)
    end

    if not SearchBox:IsFocused() and not MinInput:IsFocused() then return end

    -- Arrow navigation in dropdown
    if inp.KeyCode == Enum.KeyCode.Up then
        if #dropItems > 0 and DropFrame.Size.Y.Offset > 0 then
            UpdateDropSelection(selectedDropIdx - 1)
        else
            local prev = History:Prev()
            if prev ~= "" then SearchBox.Text = prev; MinInput.Text = prev end
        end
    elseif inp.KeyCode == Enum.KeyCode.Down then
        if #dropItems > 0 and DropFrame.Size.Y.Offset > 0 then
            UpdateDropSelection(selectedDropIdx + 1)
        else
            local nxt = History:Next()
            SearchBox.Text = nxt; MinInput.Text = nxt
        end
    elseif inp.KeyCode == Enum.KeyCode.Escape then
        HideDropdown()
        SearchBox:ReleaseFocus()
        MinInput:ReleaseFocus()
    elseif inp.KeyCode == Enum.KeyCode.Tab then
        -- autocomplete top result
        if #dropItems > 0 then
            SearchBox.Text = ":"..dropItems[selectedDropIdx].aliases[1].." "
            SearchBox.CursorPosition = #SearchBox.Text + 1
            HideDropdown()
        end
    end
end)

-- MinBar input
MinInput.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        local text = MinInput.Text:match("^%s*(.-)%s*$")
        if text ~= "" then
            ExecCommand(text:sub(1,1) == ":" and text or ":"..text)
        end
        MinInput.Text = ""
    end
end)

