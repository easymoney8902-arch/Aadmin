function U.Tween(i, info, props)
    local ok, tw = pcall(function()
        return TweenService:Create(i, info, props)
    end)
    if ok and tw then tw:Play(); return tw end
end

function U.Corner(p, r)
    local c = Instance.new("UICorner")
    c.CornerRadius = r or T.R
    c.Parent = p
    return c
end

function U.Stroke(p, col, thick, tr)
    local s = Instance.new("UIStroke")
    s.Color           = col   or T.Border
    s.Thickness       = thick or 1.5
    s.Transparency    = tr    or 0
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = p
    return s
end

function U.Pad(p, t, b, l, r)
