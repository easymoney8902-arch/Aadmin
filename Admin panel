                size=UDim2.new(1,0,0.4,0),pos=UDim2.new(0,0,0.6,0),
                xa=Enum.TextXAlignment.Center,z=2,parent=bg})
            RunService.RenderStepped:Connect(function()
                if not State.esp then return end
