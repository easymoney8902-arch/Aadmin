Registry:Add({aliases={"killaura","ka"},description="Toggle kill aura",category="Combat",
    args={{name="range",type="number",optional=true,hint="10"}},usage=":killaura [range]",
    execute=function(args)
        ENV._killaura=not ENV._killaura
        local range=tonumber(args[1]) or 10
        if ENV._killaura then
            task.spawn(function()
                while ENV._killaura do
                    local r=Root()
                    if r then
                        for _,p in ipairs(Players:GetPlayers()) do
                            if p~=LP then
                                local tr=U.GetRoot(p)
                                if tr and (tr.Position-r.Position).Magnitude<=range then
                                    local h=U.GetHum(p); if h then h.Health=h.Health-10 end
                                end
                            end
                        end
                    end
                    task.wait(0.2)
                end
            end)
            Notif.Push("KillAura ON (range "..range..")","success")
        else
            Notif.Push("KillAura OFF","warn")
        end
    end,
})
Registry:Add({aliases={"aimbotlook","ab"},description="Snap look to nearest player",category="Combat",usage=":aimbotlook",
    execute=function()
        local r=Root(); if not r then Notif.Push("No root.","error"); return end
        local best,bd=nil,math.huge
        for _,p in ipairs(Players:GetPlayers()) do
            if p~=LP then
                local tr=U.GetRoot(p)
                if tr then
                    local d=(tr.Position-r.Position).Magnitude
                    if d<bd then bd=d; best=p end
                end
            end
        end
        if not best then Notif.Push("No players nearby.","warn"); return end
        local tr=U.GetRoot(best)
        if tr then
            Cam.CameraType=Enum.CameraType.Scriptable
            Cam.CFrame=CFrame.new(Cam.CFrame.Position,tr.Position+Vector3.new(0,2,0))
            task.delay(0.05,function() Cam.CameraType=Enum.CameraType.Custom end)
            Notif.Push("Locked onto "..best.Name,"success")
        end
    end,
})

