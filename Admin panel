Registry:Add({
    aliases={"esp","wallhack","wh"},
    description="Toggle player ESP",category="Visual",usage=":esp",
    execute=function()
        State.esp = not State.esp
        local holderName="_ApexESP"

        local function removeESP()
            local h=ScreenGui:FindFirstChild(holderName)
            if h then h:Destroy() end
        end

        if not State.esp then removeESP(); Notif.Push("ESP OFF","warn"); return end

        removeESP()
        local holder=Instance.new("Folder"); holder.Name=holderName; holder.Parent=ScreenGui

        local function makeESP(p)
            if p==LP then return end
            local bg=Instance.new("BillboardGui")
            bg.Name="ESPBillboard"; bg.AlwaysOnTop=true
            bg.Size=UDim2.new(0,120,0,40); bg.StudsOffset=Vector3.new(0,3,0)
            bg.Parent=holder

            local nl=U.Label({text=p.Name, col=T.Cyan, font=T.FontBold, sz=13,
                size=UDim2.new(1,0,0.6,0), xa=Enum.TextXAlignment.Center, z=2, parent=bg})
            local hl=U.Label({text="", col=T.Green, font=T.FontLight, sz=10,
                size=UDim2.new(1,0,0.4,0), pos=UDim2.new(0,0,0.6,0),
                xa=Enum.TextXAlignment.Center, z=2, parent=bg})

            local function update()
                if not State.esp then return end
                local ch=p.Character
                local h=ch and ch:FindFirstChildOfClass("Humanoid")
                local r=ch and ch:FindFirstChild("HumanoidRootPart")
                if r then bg.Adornee=r else bg.Adornee=nil end
                if h then
                    hl.Text=("♥ %.0f/%.0f"):format(h.Health,h.MaxHealth)
                    hl.TextColor3=Color3.fromHSV((h.Health/h.MaxHealth)*0.33,1,1)
                end
            end

            RunService.RenderStepped:Connect(function()
                if not State.esp then return end
                update()
            end)
        end

        for _,p in ipairs(Players:GetPlayers()) do makeESP(p) end
        Players.PlayerAdded:Connect(function(p)
            if State.esp then makeESP(p) end
        end)
        Notif.Push("ESP ON","success")
    end,
})

