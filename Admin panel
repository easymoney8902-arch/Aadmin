    World     = { label="World",     icon="🌍", col=Color3.fromRGB(255,180,0),   order=4  },
    Combat    = { label="Combat",    icon="⚔️", col=Color3.fromRGB(255,55, 80),  order=5  },
    Utility   = { label="Utility",   icon="⚙️", col=Color3.fromRGB(160,155,185), order=6  },
    Admin     = { label="Admin",     icon="🛡️", col=Color3.fromRGB(255,145,0),   order=7  },
    Fun       = { label="Fun",       icon="🎉", col=Color3.fromRGB(255,210,60),  order=8  },
    Debug     = { label="Debug",     icon="🐛", col=Color3.fromRGB(180,255,120), order=9  },
    Teleport  = { label="Teleport",  icon="✨", col=Color3.fromRGB(130,80, 255), order=10 },
    Character = { label="Character", icon="🎭", col=Color3.fromRGB(255,80, 160), order=11 },
    Network   = { label="Network",   icon="📡", col=Color3.fromRGB(0,  200,255), order=12 },
    Info      = { label="Info",      icon="ℹ️", col=Color3.fromRGB(120,200,255), order=13 },
}

--[[
    Register a command. Schema:
    {
        name        = "speed",               -- canonical name (no colon)
        aliases     = {"speed","spd","ws"},  -- first is canonical
        description = "Set walkspeed",
        category    = "Movement",
        args        = {
            { name="value", type="number", optional=false, default=nil, hint="16" }
        },
        execute     = function(args, rawInput, ctx) ... end,
        dangerous   = false,   -- adds confirmation step
        hidden      = false,   -- hides from search
        usage       = ":speed 50",
    }
]]
function Registry:Add(def)
    assert(def.aliases and #def.aliases > 0, "Command needs at least one alias")
    assert(def.execute,   "Command needs execute function")
    assert(def.category,  "Command needs a category")
    def.name = def.name or def.aliases[1]
    local canon = def.aliases[1]:lower()
    def._canon = canon
    self._cmds[canon] = def
    for _, alias in ipairs(def.aliases) do
        self._alias[alias:lower()] = canon
    end
    if not self._cats[def.category] then
        self._cats[def.category] = {}
    end
    table.insert(self._cats[def.category], canon)
end

function Registry:Get(alias)
    local canon = self._alias[alias:lower()]
    return canon and self._cmds[canon]
end

function Registry:Search(query, limit)
    limit = limit or 20
    local results = {}
    if query == "" then
        for canon, def in pairs(self._cmds) do
            if not def.hidden then
                table.insert(results, { def=def, score=50 })
            end
        end
        table.sort(results, function(a,b)
            local ao = (Registry.CategoryDefs[a.def.category] or {}).order or 99
            local bo = (Registry.CategoryDefs[b.def.category] or {}).order or 99
            if ao ~= bo then return ao < bo end
            return a.def._canon < b.def._canon
        end)
    else
        for canon, def in pairs(self._cmds) do
            if not def.hidden then
                local bestScore = 0
                for _, alias in ipairs(def.aliases) do
                    local match, score = U.FuzzyMatch(alias, query)
                    if match and score > bestScore then bestScore = score end
                end
                local descMatch, descScore = U.FuzzyMatch(def.description or "", query)
                if descMatch and descScore * 0.4 > bestScore then
                    bestScore = math.floor(descScore * 0.4)
                end
                if bestScore > 0 then
                    table.insert(results, { def=def, score=bestScore })
                end
            end
        end
        table.sort(results, function(a,b) return a.score > b.score end)
    end
    local out = {}
    for i = 1, math.min(#results, limit) do
        table.insert(out, results[i].def)
    end
    return out
end

function Registry:All()
    local out = {}
    for _, def in pairs(self._cmds) do
        if not def.hidden then table.insert(out, def) end
    end
    return out
end

