	local GetCommandList     = getOrCreate("RemoteFunction", "GetCommandList", AdminRemotes)

	-- Permission system ------------------------------------------------
	local PermissionSystem = {}

	-- Fill in real UserIds before publishing. Keys are UserIds, values are rank names.
	local ROLE_ASSIGNMENTS = {
		-- [123456789] = "OWNER",
	}

	-- Per-command minimum rank. Populated by RegisterCommand below.
	local commandMinRank = {}

	function PermissionSystem.getRank(player)
		local roleName = ROLE_ASSIGNMENTS[player.UserId]
		if roleName and RANKS[roleName] then
			return RANKS[roleName], roleName
		end
		return RANKS.DEFAULT, "DEFAULT"
	end

	function PermissionSystem.hasPermission(player, commandName)
		if not player or not player:IsA("Player") then
			return false, "Invalid caller"
		end
		local required = commandMinRank[commandName]
		if required == nil then
			return false, "Unknown command: " .. tostring(commandName)
		end
		local rank = PermissionSystem.getRank(player)
		if rank >= required then
			return true, "OK"
		end
		return false, "Insufficient permission"
	end

	-- Command registry ---------------------------------------------------
	local CommandRegistry = {}
	local commands = {} -- [name] = { name, aliases, category, description, usage, minRank, run }
	local aliasMap = {} -- [alias] = canonical name

	function CommandRegistry.register(def)
		assert(type(def.name) == "string", "command def requires name")
		assert(type(def.run) == "function", "command def requires run(player, args)")
		def.category = def.category or "Misc"
		def.description = def.description or ""
		def.usage = def.usage or def.name
		def.minRank = def.minRank or RANKS.ADMIN
		def.aliases = def.aliases or {}

		commands[def.name] = def
		commandMinRank[def.name] = def.minRank

		for _, alias in ipairs(def.aliases) do
			aliasMap[alias] = def.name
		end
	end

	function CommandRegistry.resolve(nameOrAlias)
		if commands[nameOrAlias] then
			return commands[nameOrAlias]
		end
		local canonical = aliasMap[nameOrAlias]
		if canonical then
			return commands[canonical]
		end
		return nil
	end

	function CommandRegistry.list()
		local out = {}
		for name, def in pairs(commands) do
			table.insert(out, {
				name = def.name,
				category = def.category,
				description = def.description,
				usage = def.usage,
				minRank = def.minRank,
				aliases = def.aliases,
			})
		end
		table.sort(out, function(a, b) return a.name < b.name end)
		return out
	end

	-- Command executor ------------------------------------------------
	local CommandExecutor = {}

	function CommandExecutor.execute(player, commandName, args)
		local def = CommandRegistry.resolve(commandName)
		if not def then
			return { success = false, message = "Unknown command: " .. tostring(commandName) }
		end

		local ok, result = pcall(def.run, player, args or {})
		if not ok then
			warn(string.format("[AdminSystem] Command '%s' errored: %s", commandName, tostring(result)))
			return { success = false, message = "Command error: " .. tostring(result) }
		end

		if type(result) == "table" and result.success ~= nil then
			return result
		end
		return { success = true, message = tostring(result or (commandName .. " executed")) }
	end

