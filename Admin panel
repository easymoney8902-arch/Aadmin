-- Command processor
local function processCmd(raw)
    local parts = {}
    for word in raw:gmatch("%S+") do table.insert(parts, word) end
    if #parts == 0 then return end
    local cmd = parts[1]:lower()
    local args = {}
    for i = 2, #parts do table.insert(args, parts[i]) end

    termPrint(":"..raw, "")

    table.insert(State.TermHistory, 1, raw)
    if #State.TermHistory > 50 then table.remove(State.TermHistory) end

    task.delay(0.12, function()
        if cmd == "help" then
            if args[1] then
                local found = nil
                for _, c in ipairs(ALL_COMMANDS) do
                    if c.cmd == args[1] then found = c; break end
                end
                if found then
                    termPrint(found.cmd..": "..found.desc, "ok")
                    termPrint("Usage: "..found.usage, "ok")
                else
                    termPrint("Unknown command: "..args[1], "err")
                end
            else
                termPrint(#ALL_COMMANDS.." commands available. :help <cmd> for details.", "ok")
                local cats = {}
                for _, c in ipairs(ALL_COMMANDS) do
                    if not cats[c.cat] then cats[c.cat] = true end
                end
                local catList = {}
                for k in pairs(cats) do table.insert(catList, k) end
                termPrint("Categories: "..table.concat(catList, ", "), "sys")
            end

        elseif cmd == "clear" then
            clearBtn.MouseButton1Click:Fire()

        elseif cmd == "ping" then
            termPrint("Pong! Latency: "..math.random(8,22).."ms", "ok")

        elseif cmd == "whoami" then
            termPrint("Admin: "..State.AdminName.." | Role: "..State.AdminLevel.." | Level: 10", "ok")

        elseif cmd == "uptime" then
            termPrint("Server uptime: 14d 6h 22m 11s | Restarts: 0", "ok")

        elseif cmd == "version" then
            termPrint("NEBULA X ADMIN v2.0 | Engine: NX-Core 4.1 | Lua 5.1", "ok")

        elseif cmd == "sysinfo" then
            termPrint("CPU: "..math.random(35,55).."% | RAM: "..math.random(60,75).."% | Disk: 54% | Net: 1.2GB/s", "ok")

        elseif cmd == "stats" then
            local online = 0
            for _, p in ipairs(Players:GetPlayers()) do online = online + 1 end
            termPrint("Players in server: "..online.." | Total users: 1,248 | Bans: 12", "ok")

        elseif cmd == "echo" then
            termPrint(table.concat(args, " ") ~= "" and table.concat(args, " ") or "(empty)", "ok")

        elseif cmd == "history" then
            local n = tonumber(args[1]) or 10
            for i = 1, math.min(n, #State.TermHistory) do
                termPrint(i..": "..State.TermHistory[i], "sys")
            end

        elseif cmd == "kick" then
            if not args[1] then termPrint("Usage: :kick <user> [reason]", "err"); return end
            local target = args[1]
            local reason = #args > 1 and table.concat(args, " ", 2) or "No reason given"
            local player = Players:FindFirstChild(target)
            if player then
                player:Kick("[NEBULA X] "..reason)
                termPrint(target.." kicked: "..reason, "ok")
                toast(target.." kicked", "warn")
            else
                termPrint(target.." kicked (simulated): "..reason, "ok")
                toast(target.." kicked", "warn")
            end

        elseif cmd == "ban" or cmd == "tempban" then
            if not args[1] then termPrint("Usage: :"..cmd.." <user> [reason]", "err"); return end
            termPrint(args[1].." "..(cmd=="ban" and "permanently" or "temporarily").." banned: "..(args[2] or "No reason"), "ok")
            toast(args[1].." banned", "error")

        elseif cmd == "mute" then
            if not args[1] then termPrint("Usage: :mute <user> [duration]", "err"); return end
            termPrint(args[1].." muted"..(args[2] and " for "..args[2] or ""), "ok")
            toast(args[1].." muted", "warn")

        elseif cmd == "warn" then
            if not args[1] then termPrint("Usage: :warn <user> [reason]", "err"); return end
            termPrint("Warning issued to "..args[1]..": "..(args[2] or "Rule violation"), "ok")
            toast(args[1].." warned", "warn")

        elseif cmd == "announce" or cmd == "broadcast" then
            if #args == 0 then termPrint("Usage: :announce <message>", "err"); return end
            local msg = table.concat(args, " ")
            termPrint("Broadcast: \""..msg.."\"", "ok")
            toast("📢 "..msg, "info", "Announcement")

        elseif cmd == "lock" then
            State.ServerLocked = true
            termPrint("Server locked. New joins blocked.", "warn")
            toast("Server locked", "warn")

        elseif cmd == "unlock" then
            State.ServerLocked = false
            termPrint("Server unlocked.", "ok")
            toast("Server unlocked", "success")

        elseif cmd == "clearchat" then
            termPrint("Chat cleared.", "ok")
            toast("Chat cleared", "success")

        elseif cmd == "clearcache" then
            termPrint("Cache cleared. Freed ~128MB.", "ok")
            toast("Cache cleared", "success")

        elseif cmd == "backup" then
            local name = args[1] or ("auto_"..os.time())
            termPrint("Backup \""..name.."\" created.", "ok")
            toast("Backup created: "..name, "success")

        elseif cmd == "shutdown" or cmd == "restart" then
            local delay = tonumber(args[1]) or 30
            termPrint((cmd=="restart" and "Restart" or "Shutdown").." scheduled in "..delay.."s", "warn")
            toast("Server "..cmd.." in "..delay.."s", "warn")

        elseif cmd == "fly" then
            if not args[1] then termPrint("Usage: :fly <user>", "err"); return end
            local p = Players:FindFirstChild(args[1]) or LocalPlayer
            if p and p.Character then
                local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local bg = Instance.new("BodyGyro"); bg.MaxTorque = Vector3.new(9e9,9e9,9e9); bg.Parent = hrp
                    local bv = Instance.new("BodyVelocity"); bv.Velocity = Vector3.new(0,0,0); bv.MaxForce = Vector3.new(9e9,9e9,9e9); bv.Parent = hrp
                    termPrint(args[1].." fly mode enabled", "ok")
                    toast(args[1].." is now flying", "success")
                end
            else
                termPrint(args[1].." fly mode enabled (simulated)", "ok")
                toast(args[1].." fly enabled", "success")
            end

        elseif cmd == "god" then
            if not args[1] then termPrint("Usage: :god <user>", "err"); return end
            local p = Players:FindFirstChild(args[1])
            if p and p.Character then
                local hum = p.Character:FindFirstChildOfClass("Humanoid")
                if hum then hum.MaxHealth = math.huge; hum.Health = math.huge end
            end
            termPrint(args[1].." godmode enabled", "ok")
            toast(args[1].." godmode on", "success")

        elseif cmd == "speed" or cmd == "setspeed" then
            if not args[1] then termPrint("Usage: :setspeed <user> <value>", "err"); return end
            local val = tonumber(args[2]) or 16
            local p = Players:FindFirstChild(args[1])
            if p and p.Character then
                local hum = p.Character:FindFirstChildOfClass("Humanoid")
                if hum then hum.WalkSpeed = val end
            end
            termPrint(args[1].." speed set to "..val, "ok")
            toast(args[1].." speed → "..val, "success")

        elseif cmd == "kill" then
            if not args[1] then termPrint("Usage: :kill <user>", "err"); return end
            local p = Players:FindFirstChild(args[1])
            if p and p.Character then
                local hum = p.Character:FindFirstChildOfClass("Humanoid")
                if hum then hum.Health = 0 end
            end
            termPrint(args[1].." killed", "ok")
            toast(args[1].." killed", "warn")

        elseif cmd == "tp" then
            if not args[1] then termPrint("Usage: :tp <user>", "err"); return end
            local target = Players:FindFirstChild(args[1])
            if target and target.Character and LocalPlayer.Character then
                local tHRP = target.Character:FindFirstChild("HumanoidRootPart")
                local lHRP = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if tHRP and lHRP then
                    lHRP.CFrame = tHRP.CFrame + Vector3.new(0, 3, 0)
                    termPrint("Teleported to "..args[1], "ok")
                    toast("TP → "..args[1], "success")
                end
            else
                termPrint("Teleported to "..args[1].." (simulated)", "ok")
                toast("TP → "..args[1], "success")
            end

        elseif cmd == "bring" then
            if not args[1] then termPrint("Usage: :bring <user>", "err"); return end
            local target = Players:FindFirstChild(args[1])
            if target and target.Character and LocalPlayer.Character then
                local tHRP = target.Character:FindFirstChild("HumanoidRootPart")
                local lHRP = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if tHRP and lHRP then
                    tHRP.CFrame = lHRP.CFrame + Vector3.new(3, 0, 0)
                    termPrint("Brought "..args[1].." to you", "ok")
                    toast("Brought "..args[1], "success")
                end
            else
                termPrint("Brought "..args[1].." (simulated)", "ok")
            end

        elseif cmd == "gc" then
            termPrint("Garbage collection run. Freed ~"..math.random(50,200).."MB.", "ok")

        elseif cmd == "ping" then
            termPrint("Pong! "..math.random(8,22).."ms", "ok")

        elseif cmd == "dbstats" then
            termPrint("DB: 3 collections | 1,892 docs | 48MB | Indexes: 12", "ok")

        elseif cmd == "gravity" then
            if args[1] then
                local val = tonumber(args[1]) or 196.2
                workspace.Gravity = val
                termPrint("Gravity set to "..val, "ok")
                toast("Gravity → "..val, "success")
            else
                termPrint("Usage: :gravity <value>", "err")
            end

        elseif cmd == "time" then
            if args[1] then
                local t = tonumber(args[1])
                if args[1] == "day" then t = 14
                elseif args[1] == "night" then t = 0
                end
                if t then
                    game:GetService("Lighting").TimeOfDay = string.format("%02d:00:00", t % 24)
                    termPrint("Time set to "..tostring(args[1]), "ok")
                    toast("Time → "..args[1], "success")
                end
            else
                termPrint("Usage: :time <day|night|0-24>", "err")
            end

        elseif cmd == "fog" then
            if args[1] then
                game:GetService("Lighting").FogEnd = tonumber(args[1]) or 100000
                termPrint("Fog set to "..args[1], "ok")
            else
                termPrint("Usage: :fog <value>", "err")
            end

        elseif cmd == "ambient" then
            termPrint("Ambient settings updated", "ok")

        elseif cmd == "listroles" then
            termPrint("Owner | Admin | Moderator | Member | Guest", "ok")

        elseif cmd == "listmaps" then
            termPrint("default, arena_v2, custom_city, test_world, lobby_v3", "ok")

        elseif cmd == "whoami" then
            termPrint("You are: "..State.AdminName.." | Role: "..State.AdminLevel, "ok")

        elseif cmd == "whois" then
            if not args[1] then termPrint("Usage: :whois <user>", "err"); return end
            termPrint(args[1]..": Role=Member | Joined=2023-04-12 | Warnings=0 | Status=Online", "ok")

        elseif cmd == "sleep" then
            local n = tonumber(args[1]) or 1
            termPrint("Sleeping "..n.."s…", "sys")

        elseif cmd == "sudo" then
            if #args == 0 then termPrint("Usage: :sudo <command>", "err"); return end
            termPrint("Elevated: :"..table.concat(args, " "), "warn")
            processCmd(table.concat(args, " "))

        else
            -- Generic handler for remaining 350+ commands
            local found = nil
            for _, c in ipairs(ALL_COMMANDS) do
                if c.cmd == cmd then found = c; break end
            end
            if found then
                termPrint("✓ "..cmd.." executed: "..table.concat(args, " "), "ok")
                if math.random() > 0.6 then toast(cmd.." completed", "success") end
            else
                termPrint("Unknown: \""..cmd.."\". Type :help to list commands.", "err")
            end
        end
    end)
end

local function runTermCmd()
    local raw = termInput.Text:match("^:?(.+)$")
    if not raw or raw:match("^%s*$") then return end
    processCmd(raw)
    termInput.Text = ""
    State.TermHistIdx = -1
end

