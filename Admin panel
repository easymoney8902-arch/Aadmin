Registry:Add({
    aliases={"killaura","ka","aura"},
    description="Toggle kill aura (damages nearby players via parts)",category="Combat",usage=":killaura [range]",
    args={{name="range",type="number",optional=true,hint="10"}},
    execute=function(args)
        local key="_killaura"
        local active=ENV[key]
        ENV[key]=not active
        local range=tonumber(args[1]) or 10
        if not active then
            task.spawn(function()
                while ENV[key] do
                    local r=Root()
                    if r then
                        for _,p in ipairs(Players:GetPlayers()) do
                            if p~=LP then
                                local tr=U.GetRoot(p)
                                if tr and (tr.Position-r.Position).Magnitude<=range then
                                    local h=U.GetHum(p)
                                    if h then h.Health=h.Health-10 end
                                end
                            end
                        end
                    end
                    task.wait(0.2)
                end
            end)
            Notif.Push("KillAura ON (range "..range..")","success")
        else
            Notif.Push("KillAura OFF","warn")
        end
    end,
})

Registry:Add({
    aliases={"aimbotlook","ab"},
    description="Snap camera look to nearest player",category="Combat",usage=":aimbotlook",
    execute=function()
        local nearest,ndist=nil,math.huge
        local r=Root()
        if not r then Notif.Push("No root.","error"); return end
        for _,p in ipairs(Players:GetPlayers()) do
            if p~=LP then
                local tr=U.GetRoot(p)
                if tr then
                    local d=(tr.Position-r.Position).Magnitude
                    if d<ndist then ndist=d; nearest=p end
                end
            end
        end
        if not nearest then Notif.Push("No nearby players.","warn"); return end
        local tr=U.GetRoot(nearest)
        if tr then
            Cam.CameraType=Enum.CameraType.Scriptable
            Cam.CFrame=CFrame.new(Cam.CFrame.Position, tr.Position+Vector3.new(0,2,0))
            task.delay(0.05, function() Cam.CameraType=Enum.CameraType.Custom end)
            Notif.Push("Locked onto "..nearest.Name,"success")
        end
    end,
})

