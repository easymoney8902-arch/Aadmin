local U = {}

function U.Tween(i, info, props)
    local tw = TweenService:Create(i, info, props)
    tw:Play(); return tw
end

function U.Corner(p, r)
    local c = Instance.new("UICorner")
    c.CornerRadius = r or T.R
    c.Parent = p; return c
end

function U.Stroke(p, col, thick, tr)
    local s = Instance.new("UIStroke")
    s.Color            = col   or T.Border
    s.Thickness        = thick or 2
    s.Transparency     = tr    or 0
    s.ApplyStrokeMode  = Enum.ApplyStrokeMode.Border
    s.Parent = p; return s
end

function U.Pad(p, t, b, l, r)
    local pad = Instance.new("UIPadding")
    pad.PaddingTop    = UDim.new(0, t or 0)
    pad.PaddingBottom = UDim.new(0, b or 0)
    pad.PaddingLeft   = UDim.new(0, l or 0)
    pad.PaddingRight  = UDim.new(0, r or 0)
    pad.Parent = p; return pad
end

function U.List(p, dir, sp, ha, va)
    local l = Instance.new("UIListLayout")
    l.FillDirection       = dir or Enum.FillDirection.Vertical
    l.Padding             = UDim.new(0, sp or 0)
    l.SortOrder           = Enum.SortOrder.LayoutOrder
    l.HorizontalAlignment = ha  or Enum.HorizontalAlignment.Left
    l.VerticalAlignment   = va  or Enum.VerticalAlignment.Top
    l.Parent = p; return l
end

function U.Frame(props)
    local f = Instance.new("Frame")
    f.BackgroundColor3       = props.bg    or T.Surface
    f.BackgroundTransparency = props.tr    or 0
    f.BorderSizePixel        = 0
    f.Size                   = props.size  or UDim2.new(1, 0, 0, 30)
    f.Position               = props.pos   or UDim2.new(0, 0, 0, 0)
    f.ClipsDescendants       = props.clip  or false
    f.ZIndex                 = props.z     or 1
